load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "tunnel_proto",
    srcs = ["tunnel.proto"],
    import_prefix = "github.com/openconfig/grpctunnel",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "tunnel_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "@io_bazel_rules_go//proto:go_proto",
    ],
    importpath = "github.com/openconfig/grpctunnel/proto/tunnel",
    proto = ":tunnel_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "tunnel",
    embed = [":tunnel_go_proto"],
    importpath = "github.com/openconfig/grpctunnel/proto/tunnel",
    visibility = ["//visibility:public"],
)
